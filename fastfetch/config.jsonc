// Designed for Arch Linux
// Modified from: https://github.com/fastfetch-cli/fastfetch/pull/1025#issuecomment-2177566138
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "padding": {
            "top": 2
        },
        "source": "arch",
        "color": {
            "1": "red",
            "2": "blue"
        }
    },
    "display": {
        "color": {
            "separator": "magenta"
        },
        "separator": "  ",
        "constants": [
            "─────────────────────────────────────────────────",
            "═════════════════════════════════════════════════"
        ]
    },
    "modules": [
        {
            "type": "custom",
            "format": "{$2}",
            "outputColor": "separator"
        },
        {
            "type": "title",
            "key": " User     ",
            "keyColor": "yellow",
            "format": "{#blue}{user-name}{#}@{#red}{host-name}"
        },
        {
            "type": "host",
            "key": " Machine  ",
            "keyColor": "yellow",
            "format": "{family}"
        },
        {
            "type": "os",
            "key": " OS       ",
            "keyColor": "yellow"
        },
        {
            "type": "kernel",
            "key": " Kernel   ",
            "keyColor": "yellow"
        },
        {
            "type": "uptime",
            "key": " Uptime   ",
            "keyColor": "yellow"
        },
        {
            "type": "command",
            "key": " Root Age ",
            "keyColor": "yellow",
            "text": "if [ \"$(uname)\" = Darwin ]; then b=$(stat -f %B /var/db/.AppleSetupDone 2>/dev/null); d=$(date -r \"$b\" +%Y-%m-%d 2>/dev/null); else b=$(stat -c %W / 2>/dev/null); d=$(date -d \"@$b\" +%Y-%m-%d 2>/dev/null); fi; if [ \"${b:-0}\" -gt 0 ] 2>/dev/null; then echo \"$d ($(( ($(date +%s) - b) / 86400 )) days)\"; else echo Unknown; fi"
        },
        {
            "type": "custom",
            "format": "{$1}",
            "outputColor": "separator"
        },
        {
            "type": "shell",
            "key": " Shell    ",
            "keyColor": "green"
        },
        {
            "type": "terminal",
            "key": " Terminal ",
            "keyColor": "green"
        },
        {
            "type": "command",
            "key": " GCC      ",
            "keyColor": "green",
            "text": "v=; if [ \"$(uname)\" != Darwin ] || xcode-select -p >/dev/null 2>&1; then v=$(gcc --version 2>/dev/null | sed -n 's/^\\(.*clang\\) version \\([^ ]*\\).*/\\1 \\2/p' | head -n 1); [ -n \"$v\" ] || v=$(gcc -dumpfullversion 2>/dev/null); fi; echo \"${v:-Not Installed}\""
        },
        {
            "type": "command",
            "key": " Python   ",
            "keyColor": "green",
            "text": "python3 --version 2>&1 | cut -d' ' -f2"
        },
        {
            "type": "command",
            "key": " Julia    ",
            "keyColor": "green",
            "text": "v=$(julia --version 2>/dev/null | sed -n 's/^julia version \\([^ ]*\\).*/\\1/p' | head -n 1); echo \"${v:-Not Installed}\""
        },
        {
            "type": "command",
            "key": " Wolfram  ",
            "keyColor": "green",
            "text": "p='1s/^([0-9]+(\\.[0-9]+){0,2}).*/\\1/p'; v=; for a in /Applications/Wolfram.app /Applications/Mathematica.app \"/Applications/Wolfram Engine.app\" \"$HOME/Applications/Wolfram.app\" \"$HOME/Applications/Mathematica.app\"; do [ -d \"$a\" ] || continue; v=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' \"$a/Contents/Info.plist\" 2>/dev/null | sed -nE \"$p\"); [ -n \"$v\" ] || v=$(\"$a/Contents/MacOS/wolfram\" -version </dev/null 2>/dev/null | sed -nE \"$p\"); [ -n \"$v\" ] && break; done; [ -n \"$v\" ] || for k in wolfram math; do command -v \"$k\" >/dev/null 2>&1 && v=$(\"$k\" -version </dev/null 2>/dev/null | sed -nE \"$p\") && [ -n \"$v\" ] && break; done; echo \"${v:-Not Installed}\""
        },
        {
            "type": "custom",
            "format": "{$1}",
            "outputColor": "separator"
        },
        {
            "type": "cpu",
            "key": " CPU      ",
            "keyColor": "cyan",
            "format": "{1}"
        },
        {
            "type": "gpu",
            "key": " GPU      ",
            "keyColor": "cyan",
            "format": "{1} {2}"
        },
        {
            "type": "memory",
            "key": " RAM      ",
            "keyColor": "cyan"
        },
        {
            "type": "disk",
            "key": " Disk     ",
            "keyColor": "cyan"
        },
        {
            "type": "battery",
            "key": " Battery  ",
            "keyColor": "cyan"
        },
        {
            "type": "custom",
            "format": "{$2}",
            "outputColor": "separator"
        },
        "break",
        {
            "type": "colors",
            "paddingLeft": 15
        }
    ]
}